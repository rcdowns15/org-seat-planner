# Copy to .env.local for the app (and export for scripts). Never commit real values.
# The localhost values below are the Docker Compose dev defaults, not secrets.

# App + scripts (local Docker Postgres)
DATABASE_URL=postgres://seatplanner:seatplanner@localhost:5432/seatplanner
DATABASE_URL_UNPOOLED=postgres://seatplanner:seatplanner@localhost:5432/seatplanner

# Demo-only actions (simulate edit, simulate Workday refresh, reset)
DEMO_MODE=true

# dbt (analytics/profiles.yml), BR-04
DBT_HOST=localhost
DBT_PORT=5432
DBT_USER=seatplanner
DBT_PASSWORD=seatplanner
DBT_DBNAME=seatplanner

# Production values live in Vercel env vars and GitHub secrets only.
